{"ts": 1783928152.997, "type": "created", "payload": {"product_id": "research_insight", "detected": {"report_type": "research_insight", "audience": "exec"}, "rubric_version": "v0", "v0_skill": {"id": "research_insight", "version": "v0", "parent_version": null, "structure": {"flow": [{"step": 0, "name": "Intake & Scoping", "produces": "report_spec"}, {"step": 1, "name": "Source Curation", "subagent": "SourceCurator", "produces": "source_slices", "rule": "素材切片配 S-xxx ID"}, {"step": 2, "name": "Claim Analysis", "subagent": "Analyst", "produces": "claims", "rule": "抽 claim 挂 source_ids, 强制标冲突"}, {"step": 3, "name": "Insight Extraction", "subagent": "Insight", "produces": "insights", "rule": "案例提炼成规律, 只在 claims 内推理"}, {"step": 4, "name": "Narrative Composition", "subagent": "Writer", "produces": "draft_report", "rule": "论断携带 [S-xxx]/[C-xxx]"}, {"step": 5, "name": "Verification", "subagent": "Verifier", "produces": "verification_report", "rule": "独立对抗, 查编造/混用/剔噪", "loop_back_to": 4}, {"step": 6, "name": "Deliver", "produces": "final_doc"}], "subagents": [{"name": "SourceCurator", "responsibility": "素材切片、配 ID、去重"}, {"name": "Analyst", "responsibility": "抽 claim 挂 source、标冲突、判信源充分性"}, {"name": "Insight", "responsibility": "提炼规律/归因/趋势/建议, 只在 claims 内"}, {"name": "Writer", "responsibility": "金字塔组织、携带引用、结构化呈现"}, {"name": "Verifier", "responsibility": "对抗查错(编造/混用/噪音/越界)", "independent": true}], "memory_schema": ["config", "facts", "learned_rules"]}, "instructions": {"prose": "你是调研洞察汇报助手。基于给定异构素材(doc/pdf/excel/访谈), 为最高管理层产出可编辑的调研报告。可回溯性是生命线, 素材不足处诚实留白。", "directives": {"require_source_ref": false, "flag_source_conflict": false, "honest_on_unsupportable": false, "require_two_sources": false, "pyramid_summary": false, "mece_sections": false, "concept_consistency": false, "require_insight_triplet": false, "abstract_cases": false, "drop_noise": false, "mark_extrapolation_confidence": false, "ban_bushi_ershi": false, "require_charts": false, "match_exec_length": false, "buzzword_emphasis": false}}, "few_shots": [], "memory_content": {"config": {"required_sections": ["摘要", "核心发现", "归因分析", "趋势判断", "对我们的启示/建议"], "audience_profiles": {"exec": {"length": "<=1.5页", "focus": ["结论", "决策项"]}}}, "facts": {}, "learned_rules": []}, "changelog": "v0 调研洞察: 6步 flow + 六维 directive 全关, 作为优化起跑线(结构定上限)。"}, "rubric": {"product": "research_insight", "version": "v0", "_note": "调研洞察汇报助手 六维 rubric。机器可读镜像 调研洞察汇报助手_Rubric落地文档.md §1-3。JSON(非YAML)因 harness 走 Python stdlib。judge.score_report_research 读 report[signals] 照本文件锚点打分。", "dimensions": [{"name": "traceability", "name_zh": "可回溯性与支撑充分", "scale": [1, 5], "weight": 0.28, "hard_floor": 3, "is_reverse": false, "criteria": "论断可回溯到 source/claim;不曲解、不编造;冲突指出而非混用;素材不足处诚实留白;结论需≥2独立信源否则降级'待验证'。", "anchors": {"5": "所有论断可回溯;无曲解无编造;冲突被正确指出;素材不足处明确说明证据不足;单一信源结论均已标注'待验证'。", "4": "可回溯性完整;仅1处非关键引用缺失或表述略模糊,不影响结论。", "3": "主体可回溯,但1处关键论断无出处/轻度曲解/单一信源结论未降级。", "2": "≥1处编造事实 / 把冲突素材当一致混用 / 无支撑下强行给结论。核心可信度受损(封顶,红线)。", "1": "大量论断无法回溯或明显编造;报告事实基础整体不可信。"}, "positive_example": "人均日时长Q2达27分钟[S-001];竞品X为去重会话时长[S-003],不可直接比较;投放方向素材不足,建议补充后再定。", "negative_example": "满意度显著上升,NPS预计破50。(素材里没有)"}, {"name": "structure", "name_zh": "结构", "scale": [1, 5], "weight": 0.15, "hard_floor": null, "is_reverse": false, "criteria": "摘要≤3条bullet且每条直接写结论、按重要性排序;正文金字塔、章节MECE、紧凑无注水。", "anchors": {"5": "摘要≤3条纯结论按重要性排序;正文每章论点先行、章节MECE无重叠无遗漏;摘要与正文严格对应。", "4": "结构基本达标,摘要/正文对应清晰;仅1处轻微交叉或1条bullet偏铺陈。", "3": "有摘要+正文分层,但摘要含背景铺陈,或正文非金字塔,或章节明显重叠/遗漏。", "2": "摘要是背景介绍而非结论 / 正文与摘要对不上 / 无明显章节逻辑(封顶)。", "1": "无结构,流水账。"}, "positive_example": "• 增长由重度用户留存加深驱动,非拉新。 • 可持续性存疑,仅两期数据。 • 建议资源转向激活。", "negative_example": "• 本季度对DeepSeek用户时长进行了分析。 • 数据来自内部BI和6人访谈。(全是背景铺陈)"}, {"name": "narrative", "name_zh": "逻辑与故事线", "scale": [1, 5], "weight": 0.12, "hard_floor": null, "is_reverse": false, "criteria": "论点推进有逻辑;章节衔接自然串成故事线;同一概念/口径/术语全文含义一致。", "anchors": {"5": "一条清晰主线贯穿全文;章节因果/递进衔接自然;同一概念全文口径一致。", "4": "主线清楚;个别衔接略生硬或1处措辞不统一(不影响理解)。", "3": "能读懂,但章节像并列拼接、缺推进感;或有1处概念前后不一致。", "2": "故事线断裂跳跃 / 概念自相矛盾(封顶)。", "1": "逻辑混乱,无法跟随。"}, "positive_example": "从'时长为何涨'→'谁在涨'→'能否持续'→'我们该做什么',一条主线递进。", "negative_example": "前文'时长'指累计前台时长,后文对比时不声明换成去重会话时长。"}, {"name": "insight", "name_zh": "提炼与洞察", "scale": [1, 5], "weight": 0.22, "hard_floor": null, "is_reverse": false, "criteria": "案例抽象提炼成模式非罗列;归因/趋势(标置信)/建议三要素;噪音片段不引用;命中 expected_insights。", "anchors": {"5": "命中expected_insights;案例被提炼成规律;归因具体有据、趋势标置信度、建议可执行;噪音全部剔除。", "4": "三要素齐,但1项较泛或支撑略弱,或趋势过度外推未标置信;噪音基本剔除。", "3": "有判断但偏表面(只说'增长了'不解释),或案例是罗列而非提炼,或引用了噪音片段。", "2": "基本是素材复述 / 大量引用噪音片段充数,几乎无归因/趋势/建议(封顶)。", "1": "纯素材罗列,无任何判断。"}, "positive_example": "5家AI Native公司4家采用'人机双轨过渡'——先影子运行再切流,共性是把风险控制在可回退区间[C-003,C-004,C-005]。", "negative_example": "把5家公司案例逐条抄一遍,不提炼共性。"}, {"name": "coverage", "name_zh": "覆盖度", "scale": [1, 5], "weight": 0.08, "hard_floor": null, "is_reverse": false, "criteria": "素材支持的 key_question 全答;key_claim_ids 无遗漏;required_sections 全覆盖且非空。素材答不了的(unsupportable_questions)不算漏。", "anchors": {"5": "可答的key_question全答、关键claim无遗漏、段落齐且有实质内容。", "4": "段落齐、可答问题全答;有1个次要claim未提。", "3": "缺1个required section,或漏1个关键claim / 未答1个素材支持的key_question。", "2": "缺≥2段,或漏多个关键claim / 多个可答问题未答。", "1": "大面积缺失,报告不成形。"}, "positive_example": "五段齐全,时长变化原因与贡献用户群都答到。", "negative_example": "缺'归因分析'段,且漏答'增长由哪类用户贡献'。"}, {"name": "expression", "name_zh": "表达与受众契合", "scale": [1, 5], "weight": 0.15, "hard_floor": null, "is_reverse": true, "criteria": "面向高管精炼、结论先行、措辞严谨;关键数据用表/图结构化呈现;长度匹配受众;禁用'不是,而是'句式、不堆术语。反向维度防reward hacking。", "anchors": {"5": "结论先行直击决策;关键数据/对比用了表格或图;措辞严谨;长度合exec(≤1.5页);无违禁句式无注水。", "4": "基本精炼;有个别可删句,或1处本该用表却用文字。", "3": "一定冗余或轻度术语堆砌,或该可视化的没可视化,或长度偏离受众。", "2": "出现'不是,而是'句式 / 明显冗长套话术语堆砌 / 严重偏离长度(封顶)。", "1": "充斥空话,信息密度极低。"}, "positive_example": "用一张3行表呈现Q1/Q2时长、重度/轻度增幅、样本量。", "negative_example": "增长并非来自拉新,而是来自留存加深。(命中'不是,而是'句式)"}], "aggregate": "weighted_avg", "gates": [{"id": "red_line_traceability", "type": "hard_floor", "dimension": "traceability", "floor": 3, "rule": "任一 case traceability < 3(编造/混用冲突/无据硬结论) -> 该 case 不合格"}, {"id": "no_regression", "type": "no_regression", "drop_tolerance": 0.15, "rule": "候选版本采纳条件:目标维度↑ 且 其它维度均不塌(分维度看)"}, {"id": "structure_guard", "type": "human_review", "dimension": "structure", "floor": 3, "rule": "structure < 3 -> 人工复检"}, {"id": "narrative_guard", "type": "human_review", "dimension": "narrative", "floor": 3, "rule": "narrative < 3 -> 人工复检"}, {"id": "hack_guard", "type": "human_review", "dimension": "expression", "floor": 3, "rule": "expression < 3 -> 触发人工复检(疑似 reward hacking / 违禁句式)"}], "target": {"traceability": 4.2, "structure": 4.0, "narrative": 3.8, "insight": 3.6, "coverage": 4.0, "expression": 3.8, "overall": 4.0, "judge_human_agreement": 0.85}}}}
