        {
          "step": 5,
          "name": "Verification",
          "subagent": "Verifier",
          "produces": "verification_report",
          "rule": "独立对抗, 查编造/混用/剔噪",
          "loop_back_to": 4
        },
        {
          "step": 6,
          "name": "Deliver",
          "produces": "final_doc"
        }
      ],
      "subagents": [
        {
          "name": "SourceCurator",
          "responsibility": "素材切片、配 ID、去重"
        },
        {
          "name": "Analyst",
          "responsibility": "抽 claim 挂 source、标冲突、判信源充分性"
        },
        {
          "name": "Insight",
