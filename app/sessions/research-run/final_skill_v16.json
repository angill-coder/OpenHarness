        },
        {
          "step": 2,
          "name": "Claim Analysis",
          "subagent": "Analyst",
          "produces": "claims",
          "rule": "抽 claim 挂 source_ids, 强制标冲突"
        },
        {
          "step": 3,
          "name": "Insight Extraction",
          "subagent": "Insight",
          "produces": "insights",
          "rule": "案例提炼成规律, 只在 claims 内推理"
        },
        {
          "step": 4,
          "name": "Narrative Composition",
          "subagent": "Writer",
          "produces": "draft_report",
          "rule": "论断携带 [S-xxx]/[C-xxx]"
