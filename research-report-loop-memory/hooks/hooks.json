{
  "description": "Host-side Report Loop launcher and writing-feedback capture checkpoint.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "RESEARCH_REPORT_CAPTURE_HOOK_DIR=$HOME/.research-report-memory-v2-0821/capture-hook-state sh ${CODEBUDDY_PLUGIN_ROOT}/scripts/run-node.sh --import ${CODEBUDDY_PLUGIN_ROOT}/node_modules/tsx/dist/loader.mjs ${CODEBUDDY_PLUGIN_ROOT}/hooks/capture-checkpoint.mjs prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "RESEARCH_REPORT_CAPTURE_HOOK_DIR=$HOME/.research-report-memory-v2-0821/capture-hook-state sh ${CODEBUDDY_PLUGIN_ROOT}/scripts/run-node.sh --import ${CODEBUDDY_PLUGIN_ROOT}/node_modules/tsx/dist/loader.mjs ${CODEBUDDY_PLUGIN_ROOT}/hooks/capture-checkpoint.mjs post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "RESEARCH_REPORT_CAPTURE_HOOK_DIR=$HOME/.research-report-memory-v2-0821/capture-hook-state sh ${CODEBUDDY_PLUGIN_ROOT}/scripts/run-node.sh --import ${CODEBUDDY_PLUGIN_ROOT}/node_modules/tsx/dist/loader.mjs ${CODEBUDDY_PLUGIN_ROOT}/hooks/capture-checkpoint.mjs stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
